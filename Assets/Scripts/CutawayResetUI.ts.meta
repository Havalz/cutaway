  InputLines:
    - '// @ui {"widget":"label", "label":"Cutaway Reset pill — floats low and left, in the lower-left of the view"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Placement"}'
