  InputLines:
    - '// @ui {"widget":"label", "label":"Cutaway — controller. Markers are hand-placed stand-ins for object recognition"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Station UIs"}'
    - '// @input AssignableType_1 recordPlayerUI {"hint":"UI for the record player"}'
    - '// @input AssignableType_2 cameraUI {"hint":"UI for the camera"}'
    - '// @input AssignableType_3 lampUI {"hint":"UI for the lamp"}'
    - '// @input AssignableType_4 resetUI {"hint":"Reset pill (clears all explained dots)"}'
    - '// @input AssignableType_5 labelsUI {"hint":"Floating labels used by the explanations"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Markers (move these over the real objects)"}'
    - '// @input SceneObject recordPlayerMarker {"hint":"Record player marker (used for looking at it)"}'
    - '// @input SceneObject needleMarker {"hint":"Needle / stylus marker: the magnify bubble opens here and the line of light starts here"}'
    - '// @input SceneObject speakerMarker {"hint":"Nearest speaker marker: cone, sound rings and the chime come from here"}'
    - '// @input SceneObject cameraMarker {"hint":"Camera marker"}'
    - '// @input SceneObject lampMarker {"hint":"Lamp marker (the shade / bulb)"}'
    - '// @input SceneObject lampBaseMarker {"hint":"Lamp base marker (bottom of the pole)"}'
    - '// @input SceneObject cordStartMarker {"hint":"Where the lamp cord starts (wall outlet)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Effects"}'
    - '// @input Asset.Material glowMaterial {"hint":"Additive glow material (lines of light, rays, rings)"}'
    - '// @input Asset.Material modelMaterial {"hint":"Solid model material (cone, lens, stylus, shell panels)"}'
    - '// @input Component.AudioComponent chimeAudio {"hint":"Spatial AudioComponent placed at the speaker, holding the chime"}'
    - '// @input SceneObject coneModel {"hint":"Optional: your own speaker-cone model (pinned at the speaker marker). Leave empty to use the built-in cone"}'
    - '// @input float shelfY = -144 {"hint":"Height (world Y, cm) of the shelf the line of light runs along"}'
    - "// @input vec3 cameraFacing = {-0.3,0,-0.95} {\"hint\":\"Direction the real camera's lens points (into the room)\"}"
    - '// @input vec3 cameraLabelSide = {-1,0,0} {"hint":"World direction with empty space beside the camera; its labels go on that side (away from the book)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Looking"}'
    - "// @input float gazeEnterDeg = 12 {\"hint\":\"An object counts as 'looked at' when it is within this angle of the view center (degrees)\", \"widget\":\"slider\", \"min\":4, \"max\":30, \"step\":1}"
    - '// @input float gazeExitDeg = 24 {"hint":"The chip shrinks back once the object is farther than this from the view center (degrees)", "widget":"slider", "min":8, "max":45, "step":1}'
    - '// @ui {"widget":"group_end"}'
