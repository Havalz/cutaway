  InputLines:
    - '// @ui {"widget":"label", "label":"Cutaway — controller. Markers are hand-placed stand-ins for object recognition"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Station UIs"}'
    - '// @input AssignableType_1 recordPlayerUI {"hint":"UI for the record player"}'
    - '// @input AssignableType_2 cameraUI {"hint":"UI for the camera"}'
    - '// @input AssignableType_3 lampUI {"hint":"UI for the lamp"}'
    - '// @input AssignableType_4 resetUI {"hint":"Reset pill (clears all explained dots)"}'
    - '// @input AssignableType_5 labelsUI {"hint":"Floating labels used by the explanations"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Markers (move these over the real objects)"}'
    - '// @input SceneObject recordPlayerMarker {"hint":"Record player marker (used for looking at it; also the platter centre)"}'
    - '// @input SceneObject needleMarker {"hint":"Needle / stylus marker: the magnify bubble opens here and the line of light starts here"}'
    - '// @input SceneObject speakerMarker {"hint":"Nearest speaker marker: cone, sound rings and the chime come from here"}'
    - '// @input SceneObject cameraMarker {"hint":"Camera marker"}'
    - '// @input SceneObject lampMarker {"hint":"Lamp marker (the shade / bulb)"}'
    - '// @input SceneObject lampBaseMarker {"hint":"Lamp base marker (bottom of the pole)"}'
    - '// @input SceneObject cordStartMarker {"hint":"Where the lamp cord starts (wall outlet)"}'
    - '// @input SceneObject tableMarker {"hint":"Camera hero stage: the centre of the top surface of the round coffee table in front of the sofa. The table is surveyed by World Query hit test around it at launch"}'
    - '// @input float tableTopHeight = -144.4 {"hint":"Fallback table top (if hit testing finds no table): its height, world Y in cm (measured in the preview: -144.4)"}'
    - "// @input float tableRadius = 45 {\"hint\":\"Fallback table top: radius in cm, centred on the table marker (the oval top's inscribed circle: 45)\"}"
    - "// @input SceneObject lensBagMarker {\"hint\":\"Camera hero stage: the lens inside its bag next to the camera on the console. The replica's lens rises out of here\"}"
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Camera hero stage (Bring it closer)"}'
    - '// @input AssignableType_6 heroUI {"hint":"Control rail beside the replica (Take apart / Focus / Take a photo / Put it back)"}'
    - '// @input Asset.RenderMesh replicaBodyMesh {"hint":"Replica body mesh (Models/CameraReplica: Body), pivot at the lens mount, 14 cm wide at scale 1"}'
    - '// @input Asset.RenderMesh replicaLensMesh {"hint":"Replica lens mesh (Models/CameraReplica: Lens), pivot at the mount, pointing along +Z"}'
    - "// @input Asset.Material replicaShellMaterial {\"hint\":\"The replica's shell material (ReplicaShell slot: textures + 35% emissive lift + warm fresnel rim)\"}"
    - "// @input Asset.Material recordPlayerShellMaterial {\"hint\":\"The record player model's shell material (RecordPlayerShell slot: uber PBR, vertex colour as emissive lift, warm fresnel rim)\"}"
    - '// @input Component.AudioComponent heroLiftAudio {"hint":"Spatial AudioComponent: soft rising tone as the copy lifts off the camera"}'
    - '// @input Component.AudioComponent heroBayonetAudio {"hint":"Spatial AudioComponent: bayonet click where the lens mounts"}'
    - '// @input Component.AudioComponent heroFlightAudio {"hint":"Spatial AudioComponent: soft air sweep that follows the replica in flight"}'
    - '// @input Component.AudioComponent heroLandAudio {"hint":"Spatial AudioComponent: soft landing tone from the table"}'
    - '// @input Component.AudioComponent heroTapAudio {"hint":"Spatial AudioComponent: soft contact tap where the replica touches the table"}'
    - '// @input Asset.Matter heroMatter {"hint":"Physics matter for the table and the replica: high friction, bounciness 0.05 (HeroMatter)"}'
    - "// @input Asset.Material heroSolidMaterial {\"hint\":\"Texture-free PBR with rim highlight (additive): the replica's code-built solid parts (HeroSolid)\"}"
    - '// @input Component.AudioComponent heroPartAudio {"hint":"Spatial AudioComponent: one soft click per part as it frees itself"}'
    - '// @input Component.AudioComponent heroMirrorAudio {"hint":"Spatial AudioComponent: mirror lift (MirrorClick.wav)"}'
    - '// @input Component.AudioComponent heroShutterAudio {"hint":"Spatial AudioComponent: two-part shutter sound"}'
    - '// @input Component.AudioComponent heroPrintAudio {"hint":"Spatial AudioComponent: the print sliding out"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Effects"}'
    - '// @input Asset.Material glowMaterial {"hint":"Additive glow material (lines of light, rays, rings)"}'
    - '// @input Asset.Material modelMaterial {"hint":"Solid model material (cone, lens, stylus, shell panels)"}'
    - '// @input Component.AudioComponent chimeAudio {"hint":"Spatial AudioComponent placed at the speaker: the short warm tone as the waves leave it"}'
    - '// @input SceneObject coneModel {"hint":"Optional: your own speaker-cone model (pinned at the speaker marker). Leave empty to use the built-in cone"}'
    - '// @input float shelfY = -144 {"hint":"Height (world Y, cm) of the shelf the line of light runs along"}'
    - "// @input vec3 cameraFacing = {0.94,0,-0.34} {\"hint\":\"Direction the real camera's lens points (into the room, horizontal)\"}"
    - "// @input vec3 cameraBodySize = {11.5,11.3,14.7} {\"hint\":\"Real DSLR body (cm): x = depth along the lens axis, y = height, z = width. Centred on the camera station's bounds centre\"}"
    - '// @input Component.AudioComponent clickAudio {"hint":"Spatial AudioComponent at the camera body: mirror flip and shutter click"}'
    - '// @input Component.AudioComponent powerUpAudio {"hint":"Spatial AudioComponent at the lamp: soft rising power-up tone as the light comes on"}'
    - '// @input Component.AudioComponent crackleAudio {"hint":"Spatial AudioComponent at the stylus: the needle-drop crackle"}'
    - '// @input Component.AudioComponent tickAudio {"hint":"Spatial AudioComponent for the soft tick on every pinch (moved to the pinched control)"}'
    - '// @input Component.AudioComponent scanAudio {"hint":"Spatial AudioComponent for the scan sweep (moved to the scanned object)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Looking"}'
    - "// @input float gazeEnterDeg = 12 {\"hint\":\"An object counts as 'looked at' when it is within this angle of the view center (degrees)\", \"widget\":\"slider\", \"min\":4, \"max\":30, \"step\":1}"
    - '// @input float gazeExitDeg = 24 {"hint":"The chip shrinks back once the object is farther than this from the view center (degrees)", "widget":"slider", "min":8, "max":45, "step":1}'
    - '// @ui {"widget":"group_end"}'
