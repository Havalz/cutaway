    Node3:
      DependencyIndex: 3
      LevelID: 0
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_vec4 haloColor;
            input_vec4 haloParams;
            input_vec4 haloCenter;
            output_vec4 result;

            // A fresnel rim and nothing else: light only where the surface turns away from the eye. Additive,
            // so the alpha is the light that lands. haloParams: level, rim power, glint height (world y), glint
            // half-width. haloColor.a: the glint's level. haloCenter: the object's centre, and how far normals
            // lean away from it, so flat faces darken towards the middle of the object as seen.
            void main()
            {
            	vec3 P = system.getSurfacePositionWorldSpace();
            	vec3 V = normalize(system.getCameraPosition() - P);
            	vec3 N = normalize(system.getSurfaceNormalWorldSpace());
            	N = normalize(mix(N, normalize(P - haloCenter.xyz), haloCenter.w));
            	float f = pow(1.0 - clamp(abs(dot(N, V)), 0.0, 1.0), haloParams.y);
            	float g = 1.0 - clamp(abs(P.y - haloParams.z) / max(haloParams.w, 0.001), 0.0, 1.0);
            	float k = f * haloParams.x + g * g * sqrt(f) * haloColor.a;
            	result = vec4(haloColor.rgb, clamp(k, 0.0, 1.0));
            }
        CustomCodeNodeAsset:
          ClassType1: REFUID
          String: ""
        Description:
          ClassType1: TEXT
          String: ""
        ID:
          Variable: 0
        Locked:
          Variable: false
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: Custom Code
        UseExternalFile:
          Variable: false
        haloCenter:
          Connection0:
            NodeLevelID: 3
            PortID: Output
          Variable: [0.0, 0.0, 0.0, 0.0]
        haloColor:
          Connection0:
            NodeLevelID: 1
            PortID: Output
          Variable: [0.0, 0.0, 0.0, 0.0]
        haloParams:
          Connection0:
            NodeLevelID: 2
            PortID: Output
          Variable: [0.0, 0.0, 0.0, 0.0]
        ngs_Height:
          Variable: 400
        ngs_Version:
          String: 0.1.0
        result:
          IOType: 1
          Variable: [0.0, 0.0, 0.0, 0.0]
      PositionX: -59
